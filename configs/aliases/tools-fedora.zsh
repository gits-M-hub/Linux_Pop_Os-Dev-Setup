# ==========================
# Tools Aliases (Fedora)
# ==========================
# Abreviaciones de herramientas populares para acceso rápido
# Versión específica para Fedora donde bat se instala como 'bat' (no 'batcat')

# LazyGit
# lg = lazygit (abreviación de lazygit - interfaz de Git para terminal)
alias lg="lazygit"

# Yazi
# yz = yazi (abreviación de yazi - administrador de archivos moderno para terminal)
alias yz="yazi"

# Bat (cat mejorado)
# cat = bat (sobrescribe el comando cat original con bat - tiene resaltado de sintaxis)
# En Fedora, bat se instala como 'bat' (no como 'batcat' en Debian/Ubuntu)
alias cat="bat"
